{
  "name": "citycare-api",
  "version": "0.1.0",
  "private": true,
  "description": "CityCare API: Express server plus the Strands agent pipeline (intake, dedup, priority, router, supervisor).",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/server.js",
    "dev": "node --env-file-if-exists=../.env --watch src/server.js",
    "test": "node --test",
    "postinstall": "prisma generate",
    "db:push": "node --env-file-if-exists=../.env node_modules/prisma/build/index.js db push --skip-generate",
    "db:studio": "node --env-file-if-exists=../.env node_modules/prisma/build/index.js studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@strands-agents/sdk": "1.20.0",
    "express": "5.3.0",
    "prisma": "6.19.3",
    "zod": "4.6.5"
  }
}
