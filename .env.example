# Copy to .env and edit. docker compose reads it automatically.

# "mock" = rule-based agents, no AWS needed (default, and the demo fallback).
# "bedrock" = Strands agents backed by Claude on Amazon Bedrock.
CITYCARE_MODE=mock

# Delay (ms) per agent step in mock mode so the live trace is watchable.
MOCK_DELAY_MS=350

# Bedrock mode only. Use credentials with bedrock:InvokeModel / Converse access.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Haiku-class for intake, Sonnet-class for dedup/priority/router/supervisor.
# Verified working on our account (us-east-2, cross-region "us." profiles).
# us.anthropic.claude-haiku-5-5 / us.anthropic.claude-sonnet-5-5
INTAKE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
REASONING_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Street-address suggestions in the report form come from Photon, a free OpenStreetMap
# geocoder (no API key) that works for any location. Intersections and landmarks from the
# local city data (data/city.json) work offline without it.
# Set to "off" for fully offline demos, or point at a self-hosted Photon.
PHOTON_URL=https://photon.komoot.io

# Host port for the web UI.
WEB_PORT=8080
