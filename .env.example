# Copy to .env and edit. docker compose reads it automatically.

# "mock" = rule-based agents, no AWS needed (default, and the demo fallback).
# "bedrock" = Strands agents backed by Claude on Amazon Bedrock.
CITYCARE_MODE=mock

# Delay (ms) per agent step in mock mode so the live trace is watchable.
MOCK_DELAY_MS=350

# Bedrock mode only. Use credentials with bedrock:InvokeModel / Converse access.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Haiku-class for intake, Sonnet-class for dedup/priority/router/supervisor.
# Verified working on our account (us-east-2, cross-region "us." profiles).
# us.anthropic.claude-haiku-5-5 / us.anthropic.claude-sonnet-5-5
INTAKE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
REASONING_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Bedrock rate limits. Set BEDROCK_RPM a little under your account's "requests per
# minute" quota for the reasoning model. One report makes roughly 8-12 model calls, so
# 24 RPM handles about 2 reports a minute; extra reports wait in a queue. Our account
# throttled at about 25 calls/min on Sonnet 4.6. If Bedrock still throttles, calls pause
# and retry before a step falls back to rules.
#
# The limiter adapts: every throttle halves the pace and it recovers gradually, so it
# settles under the real quota even when teammates share the AWS account (each running
# copy has its own limiter) or the tokens-per-minute quota is the tighter one.
BEDROCK_RPM=24
BEDROCK_MAX_CONCURRENCY=4
REPORT_CONCURRENCY=2
# Output-token cap per call. Bedrock reserves it against the tokens-per-minute quota when
# a call starts, so keep it close to what the agents need.
BEDROCK_MAX_TOKENS=1024
BEDROCK_MAX_TOKENS_LONG=2048
# Seconds between retries when Bedrock throttles (about 2.5 minutes in total).
BEDROCK_THROTTLE_BACKOFF_S=8,15,30,45,60

# Street-address suggestions in the report form come from Photon, a free OpenStreetMap
# geocoder (no API key) that works for any location. Intersections and landmarks from the
# local city data (data/city.json) work offline without it.
# Set to "off" for fully offline demos, or point at a self-hosted Photon.
PHOTON_URL=https://photon.komoot.io

# Host port for the web UI.
WEB_PORT=8080
